# Full URL of the private annotation page. Use its actual HTTPS URL before deploying to production.
VITE_ANNOTATION_URL=http://127.0.0.1:4175/

# Optional HTTPS sign-in page on the annotation service origin. Leave empty until the editor supports it.
VITE_MORNINGSTAR_SIGN_IN_URL=

# Optional deployment prefix; GitHub Actions sets this from Pages metadata.
VITE_BASE_PATH=/
